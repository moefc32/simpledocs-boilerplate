---
import { Link, MoveRight } from '@lucide/svelte';

const { href, label } = Astro.props;
---

<a
    href={href}
    target="_blank"
    class="flex items-center gap-4 px-5 py-3 bg-indigo-500/60 hover:bg-indigo-500/75 leading-5 transition duration-250 ease-in-out rounded-lg cursor-pointer"
    title={label || href}
>
    <Link size={20} />
    <span class="inline-flex flex-col">
        <span class={label ? 'text-white/75 text-sm' : 'text-lg'}>
            External Link
        </span>
        <span class="text-lg">{label}</span>
    </span>
    <span class="ms-auto">
        <MoveRight size={20} />
    </span>
</a>
